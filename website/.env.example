# ==============================================================================
# SMART POWER METER IoT - TEMPLATE KONFIGURASI ENVIRONMENT (.env.example)
# Salin file ini menjadi .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi MQTT Broker
# ------------------------------------------------------------------------------
# Host/Alamat broker MQTT tempat ESP32 mempublikasikan data telemetri
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=elevate2026/powermeter/telemetry

# ------------------------------------------------------------------------------
# 2. Parameter Kelistrikan & Tarif PLN
# ------------------------------------------------------------------------------
# Batas daya kontrak meteran MCB (VA), default rumah tangga 1300 VA
KONTRAK_DAYA_VA=1300.0

# Tarif dasar listrik PLN prabayar per kWh (Golongan R1/1300 VA: Rp 1.444,70)
TARIF_PER_KWH=1444.70

# Jeda maksimum antar data (detik) untuk integrasi trapesium energi
MAX_GAP_SECONDS=300

# ------------------------------------------------------------------------------
# 3. Konfigurasi Penasihat AI / LLM Advisor (Tier 3)
# ------------------------------------------------------------------------------
# Provider LLM: "gemini" (default) atau "openai" (kompatibel Groq/OpenRouter/OpenAI)
LLM_PROVIDER=gemini

# Masukkan API Key di bawah ini (dari Google AI Studio jika gemini)
# Jika dikosongkan, sistem tetap berjalan normal dengan aturan deterministik (rule-based).
LLM_API_KEY=

# Model LLM yang digunakan
# Pilihan Gemini: gemini-3.1-flash-lite (default), gemini-2.5-flash, gemini-1.5-flash
# Pilihan Groq/OpenAI: llama-3.3-70b-versatile, gpt-4o-mini
LLM_MODEL=gemini-3.1-flash-lite

# Base URL (HANYA WAJIB jika LLM_PROVIDER=openai)
# Contoh Groq      : https://api.groq.com/openai/v1
# Contoh OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# Jeda refresh berkala otomatis saat kondisi sama (detik, default: 600 = 10 menit)
LLM_PERIODIC_S=600

# Jeda minimum antar panggilan otomatis untuk menghemat kuota API (detik, default: 30)
LLM_MIN_INTERVAL_S=30

# ------------------------------------------------------------------------------
# 4. Konfigurasi Gateway WhatsApp (WAHA)
# ------------------------------------------------------------------------------
# Pada Docker, aplikasi otomatis memakai http://waha:3000.
TZ=Asia/Makassar
WAHA_SESSION=default
WAHA_PORT=3000
# Tetapkan nilai acak yang kuat dan jangan ubah setelah WAHA pernah dijalankan.
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=
